rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isManager() {
      return isAuthenticated() && (getUserData().role == 'manager' || getUserData().role == 'admin');
    }

    // Blocked Emails Blacklist
    match /blockedEmails/{emailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation only if role is volunteer or omitted, account is not pre-disabled,
      // and email is not present in the blockedEmails blacklist
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == 'volunteer')
                    && (!('disabled' in request.resource.data) || request.resource.data.disabled == false)
                    && (!('groupId' in request.resource.data) || request.resource.data.groupId == null)
                    && !exists(/databases/$(database)/documents/blockedEmails/$(request.resource.data.email.lower()));
      // Only admins can alter security-sensitive fields: 'role', 'disabled', 'disabledAt', 'disabledBy', 'disabledReason', 'status'
      // 'groupId' is resolved server-side by the onUserGroupWrite trigger / admin callables (clients edit 'groupOrClub' only)
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled', 'disabledAt', 'disabledBy', 'disabledReason', 'status', 'groupId'])
      );
    }

    // Volunteer Groups
    // Read: Public (signup screen lists existing groups before the user is authenticated)
    // Write: Server only (onUserGroupWrite trigger + admin group callables via Admin SDK)
    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;
    }

    // Configuration Documents (Festival Branding/Sessions: /config/festival, Incentives/Rewards: /config/incentives)
    // Read: Public (so login/landing screen can display festival name, logo, and reward milestones)
    // Write: Admin only
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shifts Collection
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerId', 'managerName', 'managerEmail'])
        && (
          ((!('managerId' in resource.data) || resource.data.managerId == null || resource.data.managerId == '')
           && request.resource.data.managerId == request.auth.uid)
          ||
          (resource.data.managerId == request.auth.uid
           && (!('managerId' in request.resource.data) || request.resource.data.managerId == null || request.resource.data.managerId == ''))
        )
      );
    }

    // Registrations Collection
    // Managed exclusively through Cloud Functions (claimShift, cancelShift)
    // using Firebase Admin SDK to guarantee atomic capacity counts and strict 7-day lockout.
    // Direct client write/create/delete is disabled for non-admins to prevent race conditions & desync.
    match /registrations/{registrationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Incentives Configuration
    match /incentives/{incentiveId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Inbound WhatsApp Messages (Forwarded Volunteer Replies)
    // Managed via Cloud Functions (twilioWhatsAppWebhook); accessible to Managers and Admins
    match /inboundMessages/{messageId} {
      allow read: if isManager();
      allow write: if isAdmin();
    }
  }
}
